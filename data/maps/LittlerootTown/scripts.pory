raw `
LittlerootTown_MapScripts::
    map_script MAP_SCRIPT_ON_FRAME_TABLE, LittlerootTown_OnFrame
    .byte 0

LittlerootTown_OnFrame:
    map_script_2 VAR_ENNA_INTRO_STATE, 24, LittlerootTown_EventScript_ArrivalScene
    .2byte 0

LittlerootTown_EventScript_Trickster::
    msgbox LittlerootTown_Text_Trickster, MSGBOX_NPC
    end

LittlerootTown_Text_Trickster:
    .string "Come one, come all! \n Come see the world famous trick house! \l A Paradoxia classic, it will leave you shocked!!$"
`